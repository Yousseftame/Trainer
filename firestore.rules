rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isNotSuspended() {
      return isSignedIn() && request.auth.token.status != 'suspended';
    }

    function isActiveAccount() {
      return isNotSuspended() &&
        request.auth.token.status != 'rejected' &&
        request.auth.token.status != 'pending';
    }

    // Head coach still requires an active (non-suspended) token.
    function isHeadCoach() {
      return isActiveAccount() && request.auth.token.role == 'head_coach';
    }

    function isStaff() {
      return isActiveAccount() && (
        request.auth.token.role in [
          'head_coach',
          'assistant',
          'trainer',
          'nutritionist',
          'physiotherapist'
        ]
      );
    }

    function hasPermission(perm) {
      return isHeadCoach() || (
        isStaff() && (perm in request.auth.token.permissions)
      );
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Lifecycle / identity fields must stay immutable from the client SDK.
    // Only Admin SDK (Cloud Functions) can create accounts, flip status, or delete.
    function subscriberIdentityLocked(sid) {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.id == sid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // Staff client updates are allowlisted (identity/status stay locked separately).
    function staffSubscriberProfileKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'name',
        'phone',
        'locale',
        'sex',
        'age',
        'heightCm',
        'startingWeightKg',
        'targetWeightKg',
        'goal',
        'healthNotes',
        'coachNotes',
        'preferredPackageId',
        'updatedAt'
      ]);
    }

    // -------------------------------------------------------------
    // Public packages — catalog is public-read; writes staff-only
    // -------------------------------------------------------------
    match /packages/{packageId} {
      allow read: if true;

      allow create: if hasPermission('packages:manage') &&
        request.resource.data.id == packageId &&
        request.resource.data.keys().hasAll([
          'id', 'name', 'description', 'price', 'period',
          'durationDays', 'entitlements', 'isActive', 'createdAt', 'updatedAt'
        ]);

      allow update: if hasPermission('packages:manage') &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.id == packageId &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if hasPermission('packages:manage');
    }

    // -------------------------------------------------------------
    // Staff directory — create / update / delete ONLY via Cloud Functions
    // (Auth user + custom claims must stay in sync; DevTools cannot mint roles)
    // -------------------------------------------------------------
    match /staff/{staffId} {
      allow read: if isStaff() || isSelf(staffId);
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // Subscribers — create/status/delete ONLY via Cloud Functions
    // -------------------------------------------------------------
    match /subscribers/{subscriberId} {
      allow read: if hasPermission('subscribers:read') ||
        hasPermission('reports:read') ||
        isSelf(subscriberId);

      // Staff may edit allowed profile/notes/metrics, never identity/status
      allow update: if hasPermission('subscribers:write') &&
        subscriberIdentityLocked(subscriberId) &&
        staffSubscriberProfileKeysOnly();

      // Subscriber self-edits go through updateMySubscriberProfile (Admin SDK)
      allow update: if false;

      allow create: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Registration requests — approve/reject ONLY via Cloud Functions
    // Public may create pending requests; nobody may update/delete from client
    // -------------------------------------------------------------
    match /registration_requests/{requestId} {
      allow create: if
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasAll([
          'id', 'displayName', 'email', 'phone', 'locale', 'goal',
          'source', 'status', 'createdAt'
        ]) &&
        request.resource.data.id == requestId &&
        request.resource.data.source in ['contact', 'manual'];

      allow read: if hasPermission('subscribers:read') ||
        hasPermission('subscribers:approve') ||
        hasPermission('reports:read');

      // DevTools cannot approve/reject — Functions use Admin SDK
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Subscriptions — manual lifecycle only (no self-service edits)
    // -------------------------------------------------------------
    match /subscriptions/{subscriptionId} {
      allow read: if hasPermission('subscriptions:manage') ||
        hasPermission('subscribers:read') ||
        hasPermission('reports:read') ||
        (isActiveAccount() && resource.data.subscriberId == request.auth.uid);

      // Lifecycle writes go through Admin SDK callables only (DevTools-safe).
      allow create, update, delete: if false;
    }

    // Subscriber package change / upgrade requests (coach resolves manually).
    match /subscription_change_requests/{requestId} {
      allow read: if hasPermission('subscriptions:manage') ||
        hasPermission('subscribers:read') ||
        (isActiveAccount() && resource.data.subscriberId == request.auth.uid);

      // Creates go through requestSubscriptionChange callable (Admin SDK).
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // Programs & progress (permission-scoped; no open catch-all)
    // -------------------------------------------------------------
    // Templates have no subscriberId; assigned programs are subscriber-scoped.
    // Template edits must never silently rewrite assigned copies (app clones on assign).
    match /workout_programs/{id} {
      allow read: if hasPermission('workouts:manage') ||
        hasPermission('subscribers:read') ||
        hasPermission('reports:read') ||
        (isActiveAccount() &&
          resource.data.keys().hasAny(['subscriberId']) &&
          resource.data.subscriberId == request.auth.uid);

      allow create: if hasPermission('workouts:manage') &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasAll([
          'id', 'title', 'format', 'version', 'status', 'days',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.status in ['template', 'active', 'archived'] &&
        (
          request.resource.data.status == 'template' ||
          request.resource.data.subscriberId is string
        );

      allow update: if hasPermission('workouts:manage') &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.id == id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status in ['template', 'active', 'archived'];

      allow delete: if hasPermission('workouts:manage');
    }

    match /nutrition_programs/{id} {
      allow read: if hasPermission('nutrition:manage') ||
        hasPermission('subscribers:read') ||
        hasPermission('reports:read') ||
        (isActiveAccount() &&
          resource.data.keys().hasAny(['subscriberId']) &&
          resource.data.subscriberId == request.auth.uid);

      allow create: if hasPermission('nutrition:manage') &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasAll([
          'id', 'title', 'format', 'version', 'status', 'days',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.status in ['template', 'active', 'archived'] &&
        (
          request.resource.data.status == 'template' ||
          request.resource.data.subscriberId is string
        );

      allow update: if hasPermission('nutrition:manage') &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.id == id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status in ['template', 'active', 'archived'];

      allow delete: if hasPermission('nutrition:manage');
    }

    // Injury / rehab case files — staff manage; subscribers read own records only.
    match /physical_therapy/{id} {
      allow read: if hasPermission('physicalTherapy:read') ||
        (isActiveAccount() && resource.data.subscriberId == request.auth.uid);

      allow create: if hasPermission('physicalTherapy:manage') &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasAll([
          'id', 'subscriberId', 'injuryTitle', 'affectedArea', 'severity',
          'status', 'diagnosisDate', 'restrictions', 'rehabExercises',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.status in ['active', 'recovering', 'cleared'] &&
        request.resource.data.severity in ['mild', 'moderate', 'severe'] &&
        request.resource.data.subscriberId is string;

      allow update: if hasPermission('physicalTherapy:manage') &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.id == id &&
        request.resource.data.subscriberId == resource.data.subscriberId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status in ['active', 'recovering', 'cleared'] &&
        request.resource.data.severity in ['mild', 'moderate', 'severe'];

      allow delete: if hasPermission('physicalTherapy:manage');
    }

    // Progress records — subscribers read own; writes go through Cloud Functions
    // (entitlement-checked). Staff with progress:write may manage via client SDK.
    match /progress_measurements/{id} {
      allow read: if hasPermission('progress:read') ||
        hasPermission('reports:read') ||
        (isActiveAccount() && resource.data.subscriberId == request.auth.uid);
      allow create: if hasPermission('progress:write') &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasAll(['id', 'subscriberId', 'recordedAt']) &&
        request.resource.data.subscriberId is string;
      allow update: if hasPermission('progress:write') &&
        request.resource.data.id == id &&
        request.resource.data.subscriberId == resource.data.subscriberId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if hasPermission('progress:write');
    }

    match /progress_photos/{id} {
      allow read: if hasPermission('progress:read') ||
        hasPermission('reports:read') ||
        (isActiveAccount() && resource.data.subscriberId == request.auth.uid);
      allow create: if hasPermission('progress:write') &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasAll(['id', 'subscriberId', 'storagePath', 'takenAt', 'createdAt']) &&
        request.resource.data.subscriberId is string &&
        request.resource.data.storagePath is string;
      allow update: if hasPermission('progress:write') &&
        request.resource.data.id == id &&
        request.resource.data.subscriberId == resource.data.subscriberId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if hasPermission('progress:write');
    }

    match /progress_performance/{id} {
      allow read: if hasPermission('progress:read') ||
        hasPermission('reports:read') ||
        (isActiveAccount() && resource.data.subscriberId == request.auth.uid);
      allow create: if hasPermission('progress:write') &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasAll(['id', 'subscriberId', 'recordedAt', 'name', 'value', 'unit']) &&
        request.resource.data.subscriberId is string;
      allow update: if hasPermission('progress:write') &&
        request.resource.data.id == id &&
        request.resource.data.subscriberId == resource.data.subscriberId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if hasPermission('progress:write');
    }

    // Content metadata holds fileUrl/streamUrl/storagePath — never open to all signed-in users.
    // Staff manage/preview via client SDK; subscribers receive entitled payloads via Cloud Functions.
    match /content_assets/{id} {
      allow read: if hasPermission('content:manage') ||
        hasPermission('subscribers:read') ||
        hasPermission('reports:read');
      allow create, update, delete: if hasPermission('content:manage');
    }

    // Ops notification inbox — created by Cloud Functions; staff may only clear unread.
    match /notices/{id} {
      allow read: if hasPermission('reports:read') ||
        hasPermission('notifications:send');
      allow create, delete: if false;
      allow update: if (
          hasPermission('reports:read') ||
          hasPermission('notifications:send')
        ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['unread', 'updatedAt']) &&
        request.resource.data.unread == false;
    }

    // Trigger Email extension queue — Admin SDK only.
    match /mail/{id} {
      allow read, write: if false;
    }

    // Device push tokens — each user manages their own rows.
    match /fcm_tokens/{tokenId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isActiveAccount() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.token is string;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Subscriber creates go through logWorkoutSession callable (Admin SDK).
    // Client create is staff-only so DevTools cannot forge performance logs.
    match /workout_logs/{id} {
      allow read: if hasPermission('workouts:manage') ||
        hasPermission('progress:read') ||
        hasPermission('reports:read') ||
        (isActiveAccount() && resource.data.subscriberId == request.auth.uid);

      allow create: if hasPermission('workouts:manage') &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasAll([
          'id', 'subscriberId', 'programId', 'completedAt'
        ]) &&
        request.resource.data.subscriberId is string &&
        request.resource.data.programId is string;

      allow update: if hasPermission('workouts:manage') &&
        request.resource.data.subscriberId == resource.data.subscriberId &&
        request.resource.data.programId == resource.data.programId &&
        request.resource.data.completedAt == resource.data.completedAt;

      allow delete: if hasPermission('workouts:manage');
    }

    // Subscriber creates/updates go through logNutritionAdherence callable.
    match /nutrition_logs/{id} {
      allow read: if hasPermission('nutrition:manage') ||
        hasPermission('progress:read') ||
        hasPermission('reports:read') ||
        (isActiveAccount() && resource.data.subscriberId == request.auth.uid);

      allow create: if hasPermission('nutrition:manage') &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasAll([
          'id', 'subscriberId', 'programId', 'loggedAt'
        ]) &&
        request.resource.data.subscriberId is string &&
        request.resource.data.programId is string;

      allow update: if hasPermission('nutrition:manage') &&
        request.resource.data.subscriberId == resource.data.subscriberId &&
        request.resource.data.programId == resource.data.programId;

      allow delete: if hasPermission('nutrition:manage');
    }
  }
}
