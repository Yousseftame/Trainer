rules_version = '2';

/**
 * Cost-aware media storage:
 * - PDFs / docs under content/pdfs|docs → Firebase Storage (private, size-capped)
 * - Videos under content/videos → optional small uploads only; prefer external CDN
 * - Content binaries are staff-read only from the client SDK.
 *   Subscribers receive short-lived signed URLs from Cloud Functions after entitlement checks.
 * Deletes require content:manage so admin deleteContentAsset can clean objects.
 */
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isNotSuspended() {
      return isSignedIn() && request.auth.token.status != 'suspended';
    }

    function isActiveAccount() {
      return isNotSuspended() &&
        request.auth.token.status != 'rejected' &&
        request.auth.token.status != 'pending';
    }

    function isHeadCoach() {
      return isActiveAccount() && request.auth.token.role == 'head_coach';
    }

    function isStaff() {
      return isActiveAccount() && (
        request.auth.token.role in [
          'head_coach',
          'assistant',
          'trainer',
          'nutritionist',
          'physiotherapist'
        ]
      );
    }

    function hasPermission(perm) {
      return isHeadCoach() || (
        isStaff() && (perm in request.auth.token.permissions)
      );
    }

    function underLimit(maxBytes) {
      return request.resource.size < maxBytes;
    }

    function canReadContentObject() {
      return hasPermission('content:read') ||
        hasPermission('content:manage') ||
        hasPermission('subscribers:read');
    }

    match /content/pdfs/{allPaths=**} {
      allow read: if canReadContentObject();
      allow create, update: if hasPermission('content:manage')
        && underLimit(25 * 1024 * 1024)
        && (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType.matches('application/.*word.*') ||
          request.resource.contentType.matches('application/vnd\\..*')
        );
      allow delete: if hasPermission('content:manage');
    }

    match /content/docs/{allPaths=**} {
      allow read: if canReadContentObject();
      allow create, update: if hasPermission('content:manage')
        && underLimit(25 * 1024 * 1024)
        && (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType.matches('application/.*word.*') ||
          request.resource.contentType.matches('application/vnd\\..*') ||
          request.resource.contentType.matches('text/.*') ||
          request.resource.contentType.matches('image/.*')
        );
      allow delete: if hasPermission('content:manage');
    }

    match /content/videos/{allPaths=**} {
      allow read: if canReadContentObject();
      // Prefer Bunny/Cloudflare/Mux for the video library; local Storage is a soft cap.
      allow create, update: if hasPermission('content:manage')
        && underLimit(80 * 1024 * 1024)
        && request.resource.contentType.matches('video/.*');
      allow delete: if hasPermission('content:manage');
    }

    // Meal verification photos — private per subscriber.
    match /nutrition/meal-photos/{subscriberId}/{allPaths=**} {
      allow read: if isActiveAccount() && (
        hasPermission('nutrition:read') ||
        hasPermission('nutrition:manage') ||
        hasPermission('subscribers:read') ||
        (request.auth.uid == subscriberId &&
          request.auth.token.role == 'subscriber')
      );
      allow create, update: if isActiveAccount()
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*')
        && (
          hasPermission('nutrition:manage') ||
          (request.auth.uid == subscriberId &&
            request.auth.token.role == 'subscriber')
        );
      allow delete: if isActiveAccount() && (
        hasPermission('nutrition:manage') ||
        (request.auth.uid == subscriberId &&
          request.auth.token.role == 'subscriber')
      );
    }

    // Progress photos — private per subscriber.
    // Meta writes still go through entitlement-checked Cloud Functions.
    // progress:read = view; progress:write = staff upload/delete for any subscriber.
    match /progress/photos/{subscriberId}/{allPaths=**} {
      allow read: if isActiveAccount() && (
        hasPermission('progress:read') ||
        (request.auth.uid == subscriberId &&
          request.auth.token.role == 'subscriber')
      );
      allow create, update: if isActiveAccount()
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*')
        && (
          hasPermission('progress:write') ||
          (request.auth.uid == subscriberId &&
            request.auth.token.role == 'subscriber')
        );
      allow delete: if isActiveAccount() && (
        hasPermission('progress:write') ||
        (request.auth.uid == subscriberId &&
          request.auth.token.role == 'subscriber')
      );
    }

    // Public website home hero backgrounds — CDN-style public read for the landing page.
    match /website/home/hero/{slideId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // Public trusted-partner logos for the home marquee.
    match /website/home/trusted-partners/{logoId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(2 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // Public Who I Am section photo.
    match /website/home/who-i-am/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // Public fitness-dream gallery card images.
    match /website/home/fitness-dream/{cardId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // Public coaching-app banner mockup image.
    match /website/home/coaching-app/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // Public mission / video banner clip.
    match /website/home/video-banner/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(80 * 1024 * 1024)
        && request.resource.contentType.matches('video/.*');
      allow delete: if hasPermission('content:manage');
    }

    // Public testimonial avatars (6 fixed slots).
    match /website/home/testimonials/{slotId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(4 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // Public goals-banner feature mockups (4 fixed tabs).
    match /website/home/goals-banner/{tabId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // About page hero background.
    match /website/about/hero/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // About page My Story photo.
    match /website/about/my-story/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // About page closing CTA banner background.
    match /website/about/closing-banner/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }

    // Shared transformations gallery composites.
    match /website/common/transformations/{itemId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasPermission('content:manage')
        && underLimit(8 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasPermission('content:manage');
    }
  }
}
